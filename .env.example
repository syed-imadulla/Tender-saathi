# Tender Saathi — Environment Variables Reference
# Copy to .env for local development. Never commit .env files containing real secrets.

# ==============================================================================
# Backend Configuration
# ==============================================================================
PORT=5000
FLASK_DEBUG=false

# Allowed CORS origins (comma-separated list, e.g. for deployed frontend)
# Set to '*' or add your Vercel domains (e.g. https://tender-saathi.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Directory for generated JSON/Markdown audit reports
REPORT_DIR=reports/generated

# Optional Server-Side LLM Intelligence (Groq / OpenRouter)
# The recommendation engine operates deterministically with 100% accuracy when disabled.
TENDERSAATHI_LLM_ENABLED=false
TENDERSAATHI_LLM_PROVIDER=groq
TENDERSAATHI_LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# ==============================================================================
# Frontend Configuration (Vercel Build Environment)
# ==============================================================================
# Direct backend API URL (optional: if omitted, requests route through /api proxy)
# Example: https://tender-saathi-api.onrender.com/api
# VITE_API_URL=
